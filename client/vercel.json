{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/email-relay",
      "destination": "/api/email-relay"
    },
    {
      "source": "/api/:path*",
      "destination": "https://college-bus-backend-gj46.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
